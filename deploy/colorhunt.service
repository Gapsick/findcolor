[Unit]
Description=Color Hunt Flask app (gunicorn)
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/colorhunt
EnvironmentFile=/opt/colorhunt/deploy/colorhunt.env
ExecStart=/opt/colorhunt/venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --timeout 60 \
    --bind 127.0.0.1:8000 \
    app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
